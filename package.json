{
  "name": "ccms-root",
  "version": "1.0.0",
  "private": true,
  "description": "Campus Management & Complaint System (CCMS) Root Workspace",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:all": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend start",
    "seed:institution": "npm --prefix backend run seed:institution",
    "clean:complaints": "node backend/database/scripts/cleanSyntheticComplaints.js",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js tests/performance/release_gate.test.js tests/security/*.test.js"
  }
}
