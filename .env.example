# CCMS Environment Configuration Template
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
TENANT_DEFAULT_ID=tenant_campus_01
CAMPUS_DEFAULT_ID=main_campus

# Database & Cache Configuration
MONGO_URI=mongodb://localhost:27017/ccms_db
REDIS_URI=redis://localhost:6379

# Security & JWT Tokens (Development Placeholders - Change in Production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_32chars_min_length
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_32chars_min_length
JWT_REFRESH_EXPIRATION=7d

# reCAPTCHA v3 (Development Keys)
RECAPTCHA_SITE_KEY=6LfbH3ItAAAAAIb-oArcLQsWtm6wBEkHeZ7lifEF
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Notification Provider
NOTIFICATION_PROVIDER=email
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=no-reply@campus.edu

# Storage & AI Providers
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage/local
CLOUDINARY_API_KEY=your_cloudinary_key_here
MAPMYINDIA_API_KEY=your_mapmyindia_key_here
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
CHATBOT_API_KEY=your_chatbot_api_key_here

# Feature Flags
FEATURE_AI_ASSISTANT=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_WHATSAPP_NOTIFICATIONS=false
FEATURE_POWERBI_EXPORT=true

# Logging Level
LOG_LEVEL=info
